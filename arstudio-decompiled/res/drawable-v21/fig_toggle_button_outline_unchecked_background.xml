<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?fds_usage_disabled_button_background" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <stroke android:width="@dimen/browser_menu_divider_height" android:color="?sutro_usage_button_border" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/fbui_transparent" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <stroke android:width="@dimen/browser_menu_divider_height" android:color="?fds_usage_disabled_button_background" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/fbui_transparent" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <stroke android:width="@dimen/browser_menu_divider_height" android:color="?sutro_usage_button_border" />
        </shape>
    </item>
</selector>
