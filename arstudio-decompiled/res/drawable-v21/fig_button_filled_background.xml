<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?fds_usage_primary_button_pressed_background" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="?fds_usage_disabled_button_background" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?fds_usage_primary_button_background" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
</selector>
