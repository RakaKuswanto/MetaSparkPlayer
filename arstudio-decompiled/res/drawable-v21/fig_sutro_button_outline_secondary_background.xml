<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="?fds_usage_secondary_button_background" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/cds_black_a05" />
            <stroke android:width="@dimen/browser_menu_divider_height" android:color="?sutro_usage_button_border" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/fbui_transparent" />
            <stroke android:width="@dimen/browser_menu_divider_height" android:color="?sutro_usage_button_border" />
        </shape>
    </item>
</selector>
