<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?fds_usage_secondary_button_background" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/cds_white_a20" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/abc_decor_view_status_guard_light" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
</selector>
