<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="@dimen/abc_control_corner_material" android:color="?fds_usage_progress_ring_blue_background" />
        </shape>
    </item>
    <item>
        <rotate android:toDegrees="360.0">
            <shape android:shape="ring" android:innerRadius="@dimen/arplayer_terms_policy_padding_button" android:thickness="@dimen/abc_control_corner_material">
                <solid android:color="?fds_usage_progress_ring_blue_foreground" />
            </shape>
        </rotate>
    </item>
</layer-list>
