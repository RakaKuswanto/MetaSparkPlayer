<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/fbui_transparent" />
            <stroke android:width="@dimen/awareness_footer_divider_height" android:color="?fds_usage_disabled_button_background" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="?fds_usage_non_media_pressed" />
            <stroke android:width="@dimen/awareness_footer_divider_height" android:color="?fds_usage_primary_button_pressed_background" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/fbui_transparent" />
            <stroke android:width="@dimen/awareness_footer_divider_height" android:color="?fds_usage_primary_button_background" />
        </shape>
    </item>
</selector>
