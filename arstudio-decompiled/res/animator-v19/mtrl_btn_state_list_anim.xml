<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="@integer/fbui_popover_window_anim_exit_duration" android:valueTo="@dimen/abc_action_bar_overflow_padding_start_material" android:valueType="floatType" android:propertyName="translationZ" />
            <objectAnimator android:duration="0" android:valueTo="@dimen/abc_control_corner_material" android:valueType="floatType" android:propertyName="elevation" />
        </set>
    </item>
    <item android:state_enabled="true" android:state_hovered="true">
        <set>
            <objectAnimator android:duration="@integer/fbui_popover_window_anim_exit_duration" android:valueTo="@dimen/abc_control_corner_material" android:valueType="floatType" android:propertyName="translationZ" />
            <objectAnimator android:duration="0" android:valueTo="@dimen/abc_control_corner_material" android:valueType="floatType" android:propertyName="elevation" />
        </set>
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <set>
            <objectAnimator android:duration="@integer/fbui_popover_window_anim_exit_duration" android:valueTo="@dimen/abc_control_corner_material" android:valueType="floatType" android:propertyName="translationZ" />
            <objectAnimator android:duration="0" android:valueTo="@dimen/abc_control_corner_material" android:valueType="floatType" android:propertyName="elevation" />
        </set>
    </item>
    <item android:state_enabled="true">
        <set>
            <objectAnimator android:duration="@integer/fbui_popover_window_anim_exit_duration" android:valueTo="@dimen/arplayer_fps_pill_vertical_padding" android:valueType="floatType" android:propertyName="translationZ" android:startDelay="@integer/fbui_popover_window_anim_exit_duration" />
            <objectAnimator android:duration="0" android:valueTo="@dimen/abc_control_corner_material" android:valueType="floatType" android:propertyName="elevation" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="0" android:valueTo="@dimen/arplayer_fps_pill_vertical_padding" android:valueType="floatType" android:propertyName="translationZ" />
            <objectAnimator android:duration="0" android:valueTo="@dimen/arplayer_fps_pill_vertical_padding" android:valueType="floatType" android:propertyName="elevation" />
        </set>
    </item>
</selector>
