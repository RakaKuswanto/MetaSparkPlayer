    <style name="MigMaterialAlertDialogTitle.Material3" parent="@style/MigMaterialAlertDialogTitle">
        <item name="android:textSize">@dimen/fbui_text_size_xxxlarge_1</item>
        <item name="android:layout_marginTop">@dimen/abc_button_padding_horizontal_material</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">@dimen/fbui_popover_window_anim_enter_min_alpha</item>
        <item name="android:lineHeight">@dimen/fbui_text_size_xxxlarge_5</item>
    </style>
    <style name="WhiteBackgroundDialogTheme" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fadingEdge">none</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
    <style name="WhiteBackgroundTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fadingEdge">none</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
