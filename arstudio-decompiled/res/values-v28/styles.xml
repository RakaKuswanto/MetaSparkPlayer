        <item name="buttonBarStyle">@style/MigMaterialAlertDialogButtonBar.Material3</item>
    </style>
    <style name="MigMaterialAlertDialog.Light.Material3" parent="@style/MigMaterialAlertDialog.Light.SentenceCase">
