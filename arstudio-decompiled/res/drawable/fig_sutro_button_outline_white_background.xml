<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/fds_black_alpha10" />
            <stroke android:width="@dimen/awareness_footer_divider_height" android:color="@color/cds_white_a20" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/browser_subtitle_text_color" />
            <stroke android:width="@dimen/awareness_footer_divider_height" android:color="@color/fds_white_alpha60" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4.0dip" />
            <solid android:color="@color/fds_black_alpha20" />
            <stroke android:width="@dimen/awareness_footer_divider_height" android:color="@color/abc_decor_view_status_guard_light" />
        </shape>
    </item>
</selector>
