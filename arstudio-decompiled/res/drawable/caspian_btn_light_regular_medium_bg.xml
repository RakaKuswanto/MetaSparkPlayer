<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/fbui_border_dark" />
            <stroke android:width="1.0dip" android:color="@android:color/transparent" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_floating_window_z" android:top="@dimen/action_button_optional_padding_right" android:right="@dimen/abc_floating_window_z" android:bottom="@dimen/action_button_optional_padding_right" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/abc_decor_view_status_guard_light" />
            <stroke android:width="1.0dip" android:color="@color/browser_more_menu_divider_color" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_floating_window_z" android:top="@dimen/action_button_optional_padding_right" android:right="@dimen/abc_floating_window_z" android:bottom="@dimen/action_button_optional_padding_right" />
        </shape>
    </item>
</selector>
